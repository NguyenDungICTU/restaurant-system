# ============================================================
# RESTAURANT SYSTEM - LOCAL DEVELOPMENT
# ============================================================
# Tạo .env local từ file này:
#   cp .env.example .env
#
# LƯU Ý:
# - .env.example được phép commit lên GitHub.
# - .env là cấu hình riêng của từng máy và KHÔNG được commit.
# - Không đưa Gmail password / Google App Password thật vào file này.
# ============================================================


# ------------------------------------------------------------
# PostgreSQL used by Docker Compose
# ------------------------------------------------------------
POSTGRES_DB=restaurant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# ------------------------------------------------------------
# Backend / CORS
# ------------------------------------------------------------
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
QR_FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------
# Restaurant information
# Used by booking confirmation / cancellation emails
# ------------------------------------------------------------
RESTAURANT_PHONE=0963217400
RESTAURANT_ADDRESS="Phường Thái Sơn 2, xã Quyết Thắng, thành phố Thái Nguyên"


# ------------------------------------------------------------
# Development demo account
# ------------------------------------------------------------
SEED_DEMO_ACCOUNT=true
DEMO_USERNAME=manager
DEMO_PHONE=0963217400
DEMO_PASSWORD=demo12345
DEMO_FULL_NAME="Quản lý nhà hàng"


# ------------------------------------------------------------
# Frontend build-time API URLs
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000


# ------------------------------------------------------------
# S2-09 - Notification worker
# ------------------------------------------------------------
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
NOTIFICATION_RETRY_MINUTES=5


# ------------------------------------------------------------
# S2-09 - SMTP / Mailpit
# ------------------------------------------------------------
# Mailpit được sử dụng làm SMTP server local.
#
# Nếu chỉ demo email trong Mailpit:
#   để SMTP_RELAY_USERNAME và SMTP_RELAY_PASSWORD trống.
#
# Nếu muốn gửi email thật ra Gmail:
#   SMTP_RELAY_USERNAME=<GMAIL_ACCOUNT>
#   SMTP_RELAY_PASSWORD=<GOOGLE_APP_PASSWORD>
#
# SMTP_RELAY_PASSWORD phải là Google App Password,
# KHÔNG phải mật khẩu đăng nhập Gmail thông thường.
# ------------------------------------------------------------
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=