# Local Docker configuration for Restaurant Management System.
# Copy to .env only if you need to override the Compose defaults.
POSTGRES_DB=restaurant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional AI chat; guides, data cards and tours also work with AI disabled.
# Set a model supporting Responses API + strict Structured Outputs in your account.
# Keys belong only in the local .env, never in frontend/VITE_* or Git.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_REQUESTS_PER_MINUTE=12

# Leave these two empty. The frontend automatically uses the current host,
# which is required for phone access over the same Wi-Fi/LAN.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# QR fallback for direct backend access. When QR is downloaded from the web UI,
# the current frontend origin is embedded automatically.
QR_FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

RESTAURANT_PHONE=0963217400
RESTAURANT_ADDRESS="Địa chỉ nhà hàng chưa được cấu hình"

# S4-08 booking reminder.
BOOKING_REMINDER_LEAD_MINUTES=120
BOOKING_REMINDER_WINDOW_MINUTES=5

# Optional Gmail relay for S2-09. Leave empty for Mailpit-only demo.
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=

# S4-08 - Gmail OTP verification.
# Dùng chuỗi bí mật riêng dài >= 16 ký tự. Không commit secret thật.
EMAIL_VERIFICATION_SECRET=change-this-s4-08-secret
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_SENDS_PER_HOUR=3
EMAIL_OTP_MAX_FAILED_ATTEMPTS=5
EMAIL_VERIFICATION_TOKEN_MINUTES=30

# Để gửi Gmail THẬT trực tiếp từ backend, đặt trong .env:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.sender@gmail.com
# SMTP_PASSWORD=GOOGLE_APP_PASSWORD_16_KY_TU
# SMTP_FROM_EMAIL=your.sender@gmail.com
# SMTP_USE_TLS=true
