# Local Docker configuration for Restaurant Management System.
# Copy to .env only if you need to override the Compose defaults.
POSTGRES_DB=restaurant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Leave these two empty. The frontend automatically uses the current host,
# which is required for phone access over the same Wi-Fi/LAN.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# QR fallback for direct backend access. When QR is downloaded from the web UI,
# the current frontend origin is embedded automatically.
QR_FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

RESTAURANT_PHONE=0963217400
RESTAURANT_ADDRESS="Địa chỉ nhà hàng chưa được cấu hình"

# Optional Gmail relay for S2-09. Leave empty for Mailpit-only demo.
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
