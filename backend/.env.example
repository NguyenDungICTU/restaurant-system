PROJECT_NAME="Restaurant Management System"

# Only used when running the backend outside Docker.
# Docker Compose supplies the correct db hostname automatically.
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5433/restaurant_db"

SESSION_COOKIE_NAME="restaurant_session"
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILED_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Both localhost and 127.0.0.1 are allowed by default.
FRONTEND_URLS="http://localhost:5173,http://127.0.0.1:5173"

# Development-only demo account. Docker seeds it automatically.
SEED_DEMO_ACCOUNT=true
DEMO_USERNAME=manager
DEMO_PHONE=0963217400
DEMO_PASSWORD=demo12345
DEMO_FULL_NAME="Quản lý nhà hàng"
