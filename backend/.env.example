PROJECT_NAME="Restaurant Management System"

DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/restaurant_db"

SESSION_COOKIE_NAME="restaurant_session"

SESSION_IDLE_MINUTES=30

LOGIN_MAX_FAILED_ATTEMPTS=5

LOGIN_FAILED_WINDOW_MINUTES=15

LOGIN_LOCK_MINUTES=15

COOKIE_SECURE=false

# Both localhost and 127.0.0.1 are allowed by default.
FRONTEND_URLS="http://localhost:5173,http://127.0.0.1:5173"
QR_FRONTEND_URL="http://localhost:5173"
# For phone scanning, set QR_FRONTEND_URL to the frontend LAN/public URL.
COOKIE_SAMESITE="lax"

FRONTEND_URL="http://localhost:5173"
# Customer booking lookup/cancellation
# Set the restaurant phone shown when cancellation is less than 60 minutes.
RESTAURANT_PHONE=""

# SMTP is required to send cancellation confirmation emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
