PROJECT_NAME="Restaurant Management System"

DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/restaurant_db"

SESSION_COOKIE_NAME="restaurant_session"

SESSION_IDLE_MINUTES=30

LOGIN_MAX_FAILED_ATTEMPTS=5

LOGIN_FAILED_WINDOW_MINUTES=15

LOGIN_LOCK_MINUTES=15

COOKIE_SECURE=false

# Same-origin frontend is proxied through nginx on port 5173.
# Keep localhost origins for direct local development; the LAN URL is added
# automatically by the README workflow when the frontend is opened by IP.
FRONTEND_URLS="http://localhost:5173,http://127.0.0.1:5173"
# QR_FRONTEND_URL để trống khi dùng từ LAN; frontend sẽ truyền window.location.origin.
COOKIE_SAMESITE="lax"

FRONTEND_URL="http://localhost:5173"
# Customer booking lookup/cancellation
# Set the restaurant phone shown when cancellation is less than 60 minutes.
RESTAURANT_PHONE="0963217400"

# SMTP is used for booking confirmation and cancellation emails; Docker Compose defaults to local Mailpit.
RESTAURANT_ADDRESS="Địa chỉ nhà hàng chưa được cấu hình"
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
NOTIFICATION_RETRY_MINUTES=5

SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
